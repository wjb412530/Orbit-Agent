# Orbit-Agent（枢弈）Caddy 网关配置
# {$DOMAIN} 由 docker-compose 通过环境变量注入，Caddy 自动申请 Let's Encrypt 证书

{$DOMAIN} {
	encode gzip

	# 后端 REST API
	handle /api/* {
		reverse_proxy backend:8000
	}

	# 后端 WebSocket（Caddy 自动处理 Upgrade 头）
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# 前端 SPA（history 路由回退到 index.html）
	handle {
		root * /srv/dist
		try_files {path} /index.html
		file_server
	}
}