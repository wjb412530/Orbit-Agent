# Orbit-Agent（枢弈）生产环境变量模板
# 用法：部署到服务器时复制为 .env 并填入真实值（.env 不提交到 Git）
#
# 说明：docker-compose.prod.yml 会通过 environment 强制覆盖以下三个地址为容器内地址：
#   MYSQL_HOST=mysql、MYSQL_PORT=3306、REDIS_URL=redis://redis:6379/0
#   所以本文件里这三项填什么都会被覆盖，保留仅作参考。

# ===== 必填：公开域名 =====
# 用于 Caddy 自动 HTTPS 与前端 API 地址
DOMAIN=yourdomain.com

# ===== LLM（必填）=====
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# ===== Tavily（必填）=====
TAVILY_API_KEY=你的_TAVILY_API_KEY

# ===== RAGFlow（可选）=====
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# ===== MySQL =====
MYSQL_USER=root
MYSQL_PASSWORD=请改成强密码
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost        # 生产会被覆盖为 mysql
MYSQL_PORT=3307             # 生产会被覆盖为 3306
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ===== Redis 缓存（可选，开启则需启用 redis 服务）=====
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0   # 生产会被覆盖为 redis://redis:6379/0
SEARCH_CACHE_TTL=3600

# ===== 安全防护 =====
ALLOWED_SQL_TABLES=
SQL_QUERY_TIMEOUT=5
SQL_MAX_ROWS=100
MAX_UPLOAD_MB=20
ALLOWED_FILE_EXTENSIONS=.txt,.md,.pdf,.docx,.xlsx,.csv

# ===== 可观测性（可选，LangSmith）=====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
TRACING_PROVIDER=langsmith

# ===== 会话持久化 =====
CHECKPOINT_DB_PATH=app/data/checkpoints.db
SESSION_EXPIRE_DAYS=30